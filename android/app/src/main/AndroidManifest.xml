<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اجازه دسترسی به اینترنت -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- اگر از شبکه داخلی یا API های HTTP استفاده می‌کنید (غیرتوصیه شده ولی برای تست محلی لازم) -->
    <application
        ...
        android:usesCleartextTraffic="true"
        android:label="کارتونیا"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/NormalTheme">  {/* ← حتماً تمی که ساختیم را اینجا معرفی کنید */}
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"  {/* ← تم لانچر */}
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- مشخص کردن اسکرین اصلی برای لینک دهی عمیق (Deep Link) -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
                
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- 
           متadata مورد نیاز برای flutter_embedding_v2 که استایل نوار وضعیت (Status Bar)
           را به درستی مدیریت میکند (مثلاً_STATUS_BAR__COLOR متناسب با اپ شود) 
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
